# Neo4j (backend — set on Render in production)
NEO4J_URI=bolt://localhost:7687
# Aura production example:
# NEO4J_URI=neo4j+s://YOUR-INSTANCE-ID.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=kali-dev-password

# Graph API service
API_CORE_PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Production example (Render): comma-separated frontend origins, no trailing slashes
# CORS_ORIGIN=https://kali-lending.vercel.app,http://localhost:3000

# Frontend API URL — for local backend only; Vite uses frontend/.env (see frontend/.env.example)
VITE_API_CORE_URL=http://localhost:4000

# Officer JWT auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES=8h

# Africa's Talking (USSD + SMS) — leave blank for local stub logging
# @see https://account.africastalking.com
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=KaLI
AT_ENV=sandbox
