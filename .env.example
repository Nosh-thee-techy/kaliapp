# Neo4j (backend — set on Render in production)
NEO4J_URI=bolt://localhost:7687
# Aura production example:
# NEO4J_URI=neo4j+s://YOUR-INSTANCE-ID.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=kali-dev-password

# Graph API service
API_CORE_PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Production example (Render): comma-separated frontend origins, no trailing slashes
# CORS_ORIGIN=https://kali-lending.vercel.app,http://localhost:3000

# Frontend API URL — for local backend only; Vite uses frontend/.env (see frontend/.env.example)
VITE_API_CORE_URL=http://localhost:4000

# Officer JWT auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES=8h

# Africa's Talking (USSD + SMS) — leave blank for local stub logging
# @see https://account.africastalking.com
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=KaLI
AT_ENV=sandbox

# Featherless AI (LLM credit narratives) — get free API key with coupon AIKENYA26
# @see https://featherless.ai
FEATHERLESS_API_KEY=

# Masumi Payment Network (loan disbursement) — Masumi bounty contest
# @see https://masumi.network
MASUMI_API_KEY=
MASUMI_API_URL=https://api.masumi.network/v1
MASUMI_AGENT_ID=kali-branch-agent

# Underwriter agent (Grow Asia scoring + Masumi workflow)
GROW_ASIA_APPROVE_THRESHOLD=0.65
AUTO_DISBURSE_ON_APPROVE=false

# Open-Meteo weather (map zone analytics) — set false to force placeholder responses
OPEN_METEO_ENABLED=true

# Ground-truth loop: bonus when macro advisory + field verification align
GROUND_TRUTH_SCORE_BONUS=8

# USSD session store (Redis-backed FSM, 30 min TTL for PII safety)
# Leave blank for in-memory fallback (local dev). Production: Redis add-on on Render or Upstash.
REDIS_URL=
USSD_SHORTCODE=*384*11400#
USSD_SESSION_TTL_SEC=1800

# ElevenLabs (Kali voice agent — STT / TTS / STS on farmer readiness portal)
# @see https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_VOICE_EN=EXAVITQu4vr4xnSDxMaL
# Sarah — mature, reassuring (free-tier premade). Do NOT use Rachel (21m00…) on free plans.
# Optional per-language voice IDs (defaults to ELEVENLABS_VOICE_EN)
# ELEVENLABS_VOICE_SW=
# ELEVENLABS_VOICE_LG=
